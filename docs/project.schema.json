{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrispMesh project manifest v1",
  "description": "Structure only: does not assert image existence or verified reconstruction artifacts. Image and marker IDs must additionally be unique; marker corners must form measured, nondegenerate squares in decoded TL/TR/BR/BL order. The application and native validator enforce these geometry conditions.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "units", "images", "stages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/nonempty"},
    "name": {"$ref": "#/$defs/nonempty"},
    "units": {"const": "mm"},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"$ref": "#/$defs/nonempty"},
          "path": {"$ref": "#/$defs/path"},
          "maskPath": {"$ref": "#/$defs/path"}
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": ["width", "height", "fx", "fy", "cx", "cy", "distortion"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fx": {"type": "number", "exclusiveMinimum": 0},
        "fy": {"type": "number", "exclusiveMinimum": 0},
        "cx": {"type": "number"},
        "cy": {"type": "number"},
        "distortion": {"type": "array", "items": {"type": "number"}},
        "distortionModel": {"const": "opencv-radtan"}
      },
      "allOf": [
        {"if": {"required": ["distortionModel"]}, "then": {"properties": {"distortion": {"anyOf": [{"minItems": 4, "maxItems": 4}, {"minItems": 5, "maxItems": 5}, {"minItems": 8, "maxItems": 8}]}}}}
      ]
    },
    "board": {
      "type": "object",
      "required": ["type", "markerSizeMm", "rotatesWithObject"],
      "properties": {
        "type": {"enum": ["aruco", "apriltag"]},
        "markerSizeMm": {"type": "number", "exclusiveMinimum": 0},
        "rotatesWithObject": {"const": true},
        "dictionary": {"const": "DICT_4X4_50"},
        "markers": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "cornersMm"],
            "properties": {
              "id": {"type": "integer", "minimum": 0, "maximum": 49},
              "cornersMm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"const": 0}], "minItems": 3, "maxItems": 3}}
            }
          }
        }
      },
      "allOf": [
        {"if": {"required": ["dictionary"]}, "then": {"properties": {"type": {"const": "aruco"}}}},
        {"if": {"required": ["markers"]}, "then": {"required": ["dictionary"], "properties": {"type": {"const": "aruco"}}}}
      ]
    },
    "stages": {
      "type": "object",
      "propertyNames": {"enum": ["calibration", "poses", "sparse", "dense", "mesh", "export"]},
      "additionalProperties": {"enum": ["pending", "running", "complete", "failed", "unavailable"]}
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001f])(?:[^/]|[^/].*[^/])$"
    }
  }
}
