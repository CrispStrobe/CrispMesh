<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store and TestFlight builds run in the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Photos, calibrations and models are files and folders the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The camera, for photos taken inside the app (Take photos). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Outgoing connections only, for the optional engine on another computer. No server, no child processes. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The app and its team, as the Mac App Store provisioning profile states them (needed for TestFlight). -->
	<key>com.apple.application-identifier</key>
	<string>N9XSJ4M3GT.com.crispstrobe.crisp3ds</string>
	<key>com.apple.developer.team-identifier</key>
	<string>N9XSJ4M3GT</string>
</dict>
</plist>
