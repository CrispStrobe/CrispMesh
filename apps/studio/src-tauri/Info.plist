<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the macOS app's Info.plist by the Tauri bundler. -->
	<!-- The app uses only the system's HTTP and HTTPS stack; it contains no encryption of its own. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- An engine on the same network is reached over plain HTTP by address. This allows exactly
	     that (local addresses) and nothing on the internet; remote engines must use HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CrispMesh connects to the CrispMesh engine you name or find on your local network, such as your own computer sharing its engine.</string>
	<!-- Computers sharing their engine announce this service (bonjour.rs); the app lists them under Another engine. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_crispmesh._tcp</string>
	</array>
	<!-- The camera takes the photos of a capture inside the app (Take photos); nothing leaves the device. -->
	<key>NSCameraUsageDescription</key>
	<string>CrispMesh takes the photos of an object on a turntable with the camera; they stay on this device.</string>
	<!-- The languages the app's interface has (Studio's English and German texts). The web view
	     reports the system's preferred one of these as navigator.language; without this list it
	     would report English on a German system. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
</dict>
</plist>
