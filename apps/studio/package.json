  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "preact": "11.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
